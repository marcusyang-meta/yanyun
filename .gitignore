# source and stay tracked; index.html + assets/ are copies of the web build.
yanyun-signup/public/assets/
yanyun-signup/public/index.html
yanyun-signup/public-legacy-backup/
# mobile verification screenshots stay on disk, not in history
yanyun-mobile/screenshots/

