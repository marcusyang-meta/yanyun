{
  "description": "燕云十六声百业工具 monorepo (pnpm workspaces) — 见 README",
  "name": "yanyun",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build:web": "pnpm --filter yanyun-web run build",
    "sync-public": "node yanyun-signup/scripts/sync-public.mjs",
    "mobile:lint": "pnpm --filter yanyun-mobile run lint",
    "mobile:start": "pnpm --filter yanyun-mobile run start",
    "mobile:typecheck": "pnpm --filter yanyun-mobile exec tsc --noEmit",
    "sync-schema": "pnpm --filter yanyun-signup run sync-schema && pnpm --filter yanyun-web run sync-schema",
    "relay": "relay-compiler"
  },
  "version": "0.0.0"
}
