    "react-relay": "^21.0.1",
    "react-router-dom": "^7.18.4",
    "relay-compiler": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "tesseract.js": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.7.3",
