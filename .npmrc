# pnpm 的依赖布局与 npm 对齐（平铺 hoisted）：Metro/Expo 依赖 npm 式
# node_modules 布局，pnpm 默认的隔离布局会让 Metro 解析失败，故必须 hoisted。
node-linker=hoisted
# workspace 包链接：消费方以 "*" 声明 @yanyun/* 依赖，npm workspaces 会自动
# 链接本地包；pnpm 默认不链接非 workspace: 协议的声明，需显式打开保持等价。
link-workspace-packages=true
# peer 依赖（对应 npm 时代的 legacy-peer-deps=true，缺一不可）：
# 1) auto-install-peers=false —— 不自动为 peer 补装依赖（legacy-peer-deps
#    的本质就是 npm 不管 peer）；只靠默认的 strict-peer-dependencies=false
#    不够，那只是不拦截，pnpm 仍会主动为 peer 选版本。
# 2) dedupe-peer-dependents=false —— 不把 peer 绑到图中任意已有的同名版本。
#    默认开启时 vite-plugin-babel 的 @babel/core@^7 peer 被绑到了
#    vite-plugin-relay 带来的 8.0.9（ESM-only、无 default 导出），vite 构建
#    直接失败。两项都关后，peer 按各自声明的范围独立解析到 hoisted 布局
#    里已有的版本，与 npm 时代的解析结果一致。
auto-install-peers=false
dedupe-peer-dependents=false
